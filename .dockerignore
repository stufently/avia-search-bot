# Docker-контекст НЕ подчиняется .gitignore: без этого файла `COPY . /app`
# затаскивал в образ .git и затащил бы боевой .env с токенами.
# Ни один env-файл в образ не едет — включая шаблон: он нужен только на хосте.
.env
.env.*
*.env

.git
.github
.gitignore

# Без `**/` каталог исключается только в корне контекста — проверено: вариант
# с завершающим слэшем (`__pycache__/`) образ НЕ почистил.
__pycache__
**/__pycache__
**/*.py[cod]
.venv
venv
env
ENV

sessions
tdatas
**/*.session

**/*.log
**/*.pid
**/*.swp
**/*.bak
**/*.tmp
.idea
.vscode
**/.DS_Store
